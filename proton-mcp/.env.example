# Proton MCP — copy to `.env` next to proton_mcp.py (or index.js) and edit.

# --- Proton Bridge connection ---
PROTON_BRIDGE_HOST=127.0.0.1
PROTON_BRIDGE_IMAP_PORT=1143
PROTON_BRIDGE_SMTP_PORT=1025

# --- Credentials ---
# Your full Proton account email + the Bridge-generated app password.
# (NOT your Proton account password — find it in Bridge -> Settings -> IMAP/SMTP.)
PROTON_BRIDGE_USERNAME=you@proton.me
PROTON_BRIDGE_PASSWORD=your-bridge-app-password

# --- Sender alias ---
# Usually the same as USERNAME. Bridge also accepts any alias configured on
# your Proton account.
PROTON_BRIDGE_FROM=you@proton.me

# --- Optional ---
# HTML signature appended to every outgoing message. Leave empty to disable.
PROTON_SIGNATURE=

# pass-cli vault name (default: Personal)
# PROTON_PASS_VAULT=Personal

# rclone remote for Proton Drive (default: protondrive:)
# PROTON_DRIVE_REMOTE=protondrive:
